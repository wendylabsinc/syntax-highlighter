<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="12.0" ExtensionBundleId="sh.wendy.syntaxhighlighter.cep" ExtensionBundleVersion="1.0.0" ExtensionBundleName="Syntax Highlighter">
  <ExtensionList>
    <Extension Id="sh.wendy.syntaxhighlighter.panel" Version="1.0.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- After Effects -->
      <Host Name="AEFT" Version="[22.0,99.9]"/>
      <!-- Premiere Pro -->
      <Host Name="PPRO" Version="[22.0,99.9]"/>
      <!-- Illustrator -->
      <Host Name="ILST" Version="[26.0,99.9]"/>
      <!-- Photoshop -->
      <Host Name="PHXS" Version="[23.0,99.9]"/>
      <!-- InDesign -->
      <Host Name="IDSN" Version="[17.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="12.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="sh.wendy.syntaxhighlighter.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./dist/index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Syntax Highlighter</Menu>
          <Geometry>
            <Size>
              <Width>320</Width>
              <Height>450</Height>
            </Size>
            <MinSize>
              <Width>280</Width>
              <Height>400</Height>
            </MinSize>
            <MaxSize>
              <Width>600</Width>
              <Height>800</Height>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/icon-light.png</Icon>
            <Icon Type="DarkNormal">./icons/icon-dark.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
