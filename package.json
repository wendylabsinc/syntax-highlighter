{
  "name": "syntax-highlighter",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "office-365",
    "adobe-cep"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:packages": "npm run build -w @syntax-highlighter/core -w @syntax-highlighter/ui",
    "build:office": "npm run build -w office-365",
    "build:cep": "npm run build -w adobe-cep",
    "dev:office": "npm run dev -w office-365",
    "dev:cep": "npm run dev -w adobe-cep"
  }
}
